<UserControl x:Class="OpcUaPlayground.Controls.StatusLight"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <Grid Width="20" Height="20">
        <!-- A soft halo so the lit state reads at a glance on the dark panel. -->
        <Ellipse x:Name="Halo" Margin="0" Opacity="0.25"/>
        <Ellipse x:Name="Lamp" Margin="3"
                 Stroke="{StaticResource Brush.Border}" StrokeThickness="1"/>
    </Grid>
</UserControl>
