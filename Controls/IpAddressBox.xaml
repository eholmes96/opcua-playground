<UserControl x:Class="OpcUaPlayground.Controls.IpAddressBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Dot" TargetType="TextBlock">
            <Setter Property="Text" Value="."/>
            <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>
    </UserControl.Resources>

    <Border x:Name="Frame"
            Background="{StaticResource Brush.Panel}"
            BorderBrush="{StaticResource Brush.Border}"
            BorderThickness="1" CornerRadius="3"
            Padding="6,4" MinHeight="30">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBox x:Name="Octet0" Style="{StaticResource OctetTextBox}"/>
            <TextBlock Style="{StaticResource Dot}"/>
            <TextBox x:Name="Octet1" Style="{StaticResource OctetTextBox}"/>
            <TextBlock Style="{StaticResource Dot}"/>
            <TextBox x:Name="Octet2" Style="{StaticResource OctetTextBox}"/>
            <TextBlock Style="{StaticResource Dot}"/>
            <TextBox x:Name="Octet3" Style="{StaticResource OctetTextBox}"/>
        </StackPanel>
    </Border>
</UserControl>
