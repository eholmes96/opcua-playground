<Window x:Class="OpcUaPlayground.Dialogs.DarkMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OPC UA Playground"
        Icon="/Resources/AppIcon.ico"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        ShowInTaskbar="False"
        MinWidth="300" MaxWidth="460"
        Background="{StaticResource Brush.Background}"
        Foreground="{StaticResource Brush.TextPrimary}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <StackPanel Margin="20,16">
        <TextBlock x:Name="MessageTextBlock" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="YesButton" MinWidth="86" Visibility="Collapsed"
                    Style="{StaticResource AccentButton}"
                    Click="YesButton_Click"/>
            <Button x:Name="NoButton" MinWidth="86" Margin="8,0,0,0" Visibility="Collapsed"
                    Click="NoButton_Click"/>
            <Button x:Name="CancelButton" Content="Cancel" MinWidth="86" Margin="8,0,0,0"
                    Visibility="Collapsed" IsCancel="True"
                    Click="CancelButton_Click"/>
            <Button x:Name="OkButton" Content="OK" MinWidth="86" Margin="8,0,0,0"
                    IsDefault="True" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
