<Window x:Class="OpcUaPlayground.Dialogs.DarkPromptBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OPC UA Playground"
        Icon="/Resources/AppIcon.ico"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        SizeToContent="Height"
        ShowInTaskbar="False"
        Width="420"
        Background="{StaticResource Brush.Background}"
        Foreground="{StaticResource Brush.TextPrimary}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <StackPanel Margin="20,16">
        <TextBlock x:Name="MessageTextBlock" TextWrapping="Wrap"/>
        <TextBox x:Name="InputTextBox" Margin="0,12,0,0"/>
        <TextBlock x:Name="ProblemTextBlock" Margin="0,6,0,0" TextWrapping="Wrap"
                   Visibility="Collapsed"
                   Foreground="{StaticResource Brush.StatusFault}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="OkButton" Content="OK" MinWidth="86" IsDefault="True"
                    Style="{StaticResource AccentButton}"
                    Click="OkButton_Click"/>
            <Button Content="Cancel" MinWidth="86" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
