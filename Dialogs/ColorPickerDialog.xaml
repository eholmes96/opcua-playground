<Window x:Class="OpcUaPlayground.Dialogs.ColorPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tag color"
        Icon="/Resources/AppIcon.ico"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        ShowInTaskbar="False"
        Background="{StaticResource Brush.Background}"
        Foreground="{StaticResource Brush.TextPrimary}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <!-- A palette square: no chrome, the code draws the square itself. -->
        <ControlTemplate x:Key="BareButton" TargetType="Button">
            <ContentPresenter/>
        </ControlTemplate>

        <!-- The three tabs along the bottom. A line along the top marks the one showing. -->
        <Style x:Key="TabRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="GroupName" Value="PickerTabs"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{StaticResource Brush.PanelDeep}"
                                BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,2,0,0"
                                Padding="0,7">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Accent}"/>
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Panel}"/>
                                <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A color slider: the track is a gradient (set from code as Background) and the thumb
             a ring, so the track's color shows through it. -->
        <Style x:Key="GradientSlider" TargetType="Slider">
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="255"/>
            <Setter Property="SmallChange" Value="1"/>
            <Setter Property="LargeChange" Value="16"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="TickFrequency" Value="1"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Accent}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="20" Background="Transparent">
                            <Border Height="10" CornerRadius="5" Margin="7,0"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Focusable="False" Width="14" Height="14">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid>
                                                    <Ellipse Stroke="#FF000000" StrokeThickness="1" Fill="Transparent"/>
                                                    <Ellipse Margin="1" Stroke="#FFFFFFFF" StrokeThickness="2" Fill="Transparent"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChannelLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ChannelBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="46"/>
            <Setter Property="MaxLength" Value="3"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Margin" Value="5,0,10,0"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="16,14,16,16" Width="300">
        <TextBlock x:Name="TagNameText" Foreground="{StaticResource Brush.TextSecondary}"
                   TextTrimming="CharacterEllipsis"/>

        <!-- The page for the tab that is showing. Fixed size, so switching tabs doesn't move
             anything else. -->
        <Grid Height="300" Margin="0,10,0,0">

            <!-- ============ Palette ============ -->
            <Grid x:Name="PalettePage">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <UniformGrid x:Name="PaletteGrid" Rows="6" Columns="6"
                             Width="240" Height="240" HorizontalAlignment="Center"/>
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <Button x:Name="SaveToPaletteButton" Content="Save to palette" Padding="9,4" MinHeight="0"
                            ToolTip="Put the current color in the first empty square, or the selected square if it's empty. When the palette is full, it replaces the selected square."
                            Click="SaveToPaletteButton_Click"/>
                    <Button x:Name="ClearSquareButton" Content="Clear square" Padding="9,4" MinHeight="0" Margin="6,0,0,0"
                            ToolTip="Empty the selected square."
                            Click="ClearSquareButton_Click"/>
                    <Button x:Name="ResetPaletteButton" Content="Reset palette" Padding="9,4" MinHeight="0" Margin="6,0,0,0"
                            ToolTip="Put the palette back as it came: the 24 presets and two empty rows."
                            Click="ResetPaletteButton_Click"/>
                </StackPanel>
                <TextBlock x:Name="PaletteStatusText" Grid.Row="2" Margin="0,6,0,0"
                           TextAlignment="Center" TextWrapping="Wrap" FontSize="11"
                           Foreground="{StaticResource Brush.TextSecondary}"/>
            </Grid>

            <!-- ============ Wheel ============ -->
            <Grid x:Name="WheelPage" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid x:Name="WheelSurface" Width="240" Height="240" HorizontalAlignment="Center"
                      Background="Transparent" Cursor="Cross"
                      AutomationProperties.Name="Color wheel">
                    <Image x:Name="WheelImage" Width="240" Height="240" IsHitTestVisible="False"/>
                    <!-- Darkens the disc as brightness comes down, as the Mac picker does. -->
                    <Ellipse x:Name="WheelShade" Fill="#FF000000" Opacity="0" IsHitTestVisible="False"/>
                    <Canvas IsHitTestVisible="False">
                        <Grid x:Name="WheelMarker" Width="12" Height="12">
                            <Ellipse Stroke="#FF000000" StrokeThickness="1"/>
                            <Ellipse Margin="1" Stroke="#FFFFFFFF" StrokeThickness="2"/>
                        </Grid>
                    </Canvas>
                </Grid>
                <Grid Grid.Row="1" Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Brightness" Style="{StaticResource ChannelLabel}" Margin="0,0,10,0"/>
                    <Slider x:Name="BrightnessSlider" Grid.Column="1" Style="{StaticResource GradientSlider}"
                            AutomationProperties.Name="Brightness"
                            ValueChanged="BrightnessSlider_ValueChanged"/>
                </Grid>
            </Grid>

            <!-- ============ RGB ============ -->
            <StackPanel x:Name="RgbPage" Visibility="Collapsed" VerticalAlignment="Center">
                <Grid Margin="0,0,0,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="R" Style="{StaticResource ChannelLabel}"/>
                    <Slider x:Name="RedSlider" Grid.Column="1" Style="{StaticResource GradientSlider}"
                            AutomationProperties.Name="Red slider" ValueChanged="ChannelSlider_ValueChanged"/>
                </Grid>
                <Grid Margin="0,0,0,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="G" Style="{StaticResource ChannelLabel}"/>
                    <Slider x:Name="GreenSlider" Grid.Column="1" Style="{StaticResource GradientSlider}"
                            AutomationProperties.Name="Green slider" ValueChanged="ChannelSlider_ValueChanged"/>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="B" Style="{StaticResource ChannelLabel}"/>
                    <Slider x:Name="BlueSlider" Grid.Column="1" Style="{StaticResource GradientSlider}"
                            AutomationProperties.Name="Blue slider" ValueChanged="ChannelSlider_ValueChanged"/>
                </Grid>
            </StackPanel>
        </Grid>

        <!-- The color itself: what it was and what it will be, and its three channels. -->
        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="3"
                    Width="56" Height="30" Margin="0,0,14,0" ClipToBounds="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Rectangle x:Name="OldSwatch" ToolTip="Before"/>
                    <Rectangle x:Name="NewSwatch" Grid.Column="1" ToolTip="Now"/>
                </Grid>
            </Border>
            <TextBlock Text="R" Style="{StaticResource ChannelLabel}"/>
            <TextBox x:Name="RedBox" Style="{StaticResource ChannelBox}" AutomationProperties.Name="Red"/>
            <TextBlock Text="G" Style="{StaticResource ChannelLabel}"/>
            <TextBox x:Name="GreenBox" Style="{StaticResource ChannelBox}" AutomationProperties.Name="Green"/>
            <TextBlock Text="B" Style="{StaticResource ChannelLabel}"/>
            <TextBox x:Name="BlueBox" Style="{StaticResource ChannelBox}" AutomationProperties.Name="Blue" Margin="5,0,0,0"/>
        </StackPanel>

        <UniformGrid Columns="3" Margin="0,14,0,0">
            <RadioButton x:Name="PaletteTab" Content="Palette" Style="{StaticResource TabRadio}" Checked="Tab_Checked"/>
            <RadioButton x:Name="WheelTab" Content="Wheel" Style="{StaticResource TabRadio}" Checked="Tab_Checked"/>
            <RadioButton x:Name="RgbTab" Content="RGB" Style="{StaticResource TabRadio}" Checked="Tab_Checked"/>
        </UniformGrid>

        <DockPanel Margin="0,16,0,0" LastChildFill="False">
            <Button x:Name="DefaultColorButton" Content="Default" MinWidth="76" DockPanel.Dock="Left"
                    ToolTip="Back to the standard blue."
                    Click="DefaultColorButton_Click"/>
            <Button x:Name="CancelButton" Content="Cancel" MinWidth="76" Margin="8,0,0,0"
                    DockPanel.Dock="Right" IsCancel="True"/>
            <Button x:Name="OkButton" Content="OK" MinWidth="76" DockPanel.Dock="Right"
                    Style="{StaticResource AccentButton}" IsDefault="True"
                    Click="OkButton_Click"/>
        </DockPanel>
    </StackPanel>
</Window>
