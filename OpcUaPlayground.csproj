<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>OpcUaPlayground</AssemblyName>
    <RootNamespace>OpcUaPlayground</RootNamespace>

    <!-- Shown on the exe, the taskbar and the shortcut. -->
    <ApplicationIcon>Resources\AppIcon.ico</ApplicationIcon>

    <!-- A build records the folder it was made in, e.g. in the debug-symbol path. Map it to a
         neutral one so a released exe doesn't carry this machine's folder or user names. -->
    <PathMap>$(MSBuildProjectDirectory)=/_/</PathMap>
  </PropertyGroup>

  <!-- So the file's properties say what it is rather than nothing at all. -->
  <PropertyGroup>
    <Product>OPC UA Playground</Product>
    <AssemblyTitle>OPC UA Playground</AssemblyTitle>
    <Description>Browse, monitor and record Logix controller tags over EtherNet/IP. Read only.</Description>
    <Version>0.8.4</Version>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\CipVendors.tsv"/>
    <EmbeddedResource Include="Resources\CipDeviceTypes.tsv"/>

    <!-- ApplicationIcon covers the shell. A Resource entry is what lets the windows use it too. -->
    <Resource Include="Resources\AppIcon.ico"/>
  </ItemGroup>

</Project>
